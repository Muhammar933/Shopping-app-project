// THREADLY - Prisma Database Schema
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum TryOnStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          Role            @default(USER)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  cart          Cart?
  orders        Order[]
  favorites     Favorite[]
  reviews       Review[]
  addresses     Address[]
  tryOnSessions TryOnSession[]

  @@index([email])
}

model Address {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String   // e.g., "Home", "Studio"
  street      String
  city        String
  state       String
  postalCode  String
  country     String   @default("US")
  isDefault   Boolean  @default(false)
  orders      Order[]

  @@index([userId])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id            String           @id @default(uuid())
  name          String
  slug          String           @unique
  description   String
  price         Decimal          @db.Decimal(10, 2)
  discountPrice Decimal?         @db.Decimal(10, 2)
  sku           String           @unique
  images        String[]
  isFeatured    Boolean          @default(false)
  isNew         Boolean          @default(false)
  isBestSeller  Boolean          @default(false)
  categoryId    String
  category      Category         @relation(fields: [categoryId], references: [id])
  variants      ProductVariant[]
  reviews       Review[]
  favorites     Favorite[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  tryOnSessions TryOnSession[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([categoryId])
  @@index([isFeatured, isBestSeller])
  @@index([slug])
}

model ProductVariant {
  id          String      @id @default(uuid())
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size        String      // XS, S, M, L, XL, XXL
  colorName   String      // e.g., "Washed Charcoal", "Off-White"
  colorHex    String      // Hex color code
  stock       Int         @default(0)
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@unique([productId, size, colorName])
  @@index([productId])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(uuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id])
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int            @default(1)

  @@unique([cartId, variantId])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  @@index([productId])
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  addressId     String
  address       Address     @relation(fields: [addressId], references: [id])
  status        OrderStatus @default(PENDING)
  subtotal      Decimal     @db.Decimal(10, 2)
  shippingFee   Decimal     @db.Decimal(10, 2)
  total         Decimal     @db.Decimal(10, 2)
  items         OrderItem[]
  payment       Payment?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId])
  @@index([orderNumber])
}

model OrderItem {
  id          String         @id @default(uuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product        @relation(fields: [productId], references: [id])
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  unitPrice   Decimal        @db.Decimal(10, 2)
  quantity    Int

  @@index([orderId])
}

model Payment {
  id            String   @id @default(uuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      String   @default("MOCK_PAYMENT")
  transactionId String   @unique
  amount        Decimal  @db.Decimal(10, 2)
  status        String
  createdAt     DateTime @default(now())
}

model TryOnSession {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product       @relation(fields: [productId], references: [id])
  inputImage  String
  status      TryOnStatus   @default(PENDING)
  result      TryOnResult?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
}

model TryOnResult {
  id          String       @id @default(uuid())
  sessionId   String       @unique
  session     TryOnSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  resultImage String
  createdAt   DateTime     @default(now())
}
